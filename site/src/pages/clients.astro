---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import LogoGrid from '../components/LogoGrid.astro';
import CtaBand from '../components/CtaBand.astro';

const segments = await getCollection('clientSegments');
---

<Base
  title="Clients"
  description="Zeliade Systems works with central counterparties, exchanges, banks, hedge funds and asset managers across Europe, Asia and North America."
>
  <PageHeader eyebrow="Clients" title="We work with" />

  {
    segments.map((segment, index) => (
      <Section tone={index % 2 === 1 ? 'alt' : 'default'} id={segment.id}>
        <h2 class="segment__heading">{segment.data.heading}</h2>
        {segment.data.note && <p class="segment__note">{segment.data.note}</p>}

        {segment.data.groups.map((group) => (
          <div class="segment__group">
            {group.label && <h3 class="segment__label">{group.label}</h3>}
            <LogoGrid logos={group.logos} />
          </div>
        ))}
      </Section>
    ))
  }

  <CtaBand />
</Base>

<style>
  .segment__heading { font-size: var(--step-2); max-width: 40ch; }
  .segment__note { margin-top: 0.75rem; max-width: 62ch; color: var(--ink-soft); }
  .segment__group { margin-top: 1.75rem; }
  .segment__label {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.9rem;
  }
</style>
