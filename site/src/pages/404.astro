---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { nav } from '../data/nav';

const links = nav.flatMap((item) =>
  item.children ? item.children : item.href ? [{ label: item.label, href: item.href }] : []
);
---

<Base title="Page not found" description="This page does not exist on zeliade.com.">
  <PageHeader
    title="Page not found"
    lede="The page you were looking for has moved or no longer exists."
  />
  <Section narrow>
    <ul class="links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </Section>
</Base>

<style>
  .links { list-style: none; margin: 0; padding: 0; font-size: var(--step-1); line-height: 2.1; }
</style>
