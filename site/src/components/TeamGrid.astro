---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

const people = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  people.map(async (person) => ({ person, Content: (await render(person)).Content }))
);
---

<ul class="team">
  {
    rendered.map(({ person, Content }) => (
      <li class="member">
        <Image
          class="member__photo"
          src={person.data.photo}
          alt={`Portrait of ${person.data.name}`}
          widths={[240, 480]}
          sizes="(min-width: 52rem) 240px, 45vw"
        />
        <div class="member__text">
          <h2 class="member__name">{person.data.name}</h2>
          <p class="member__role">{person.data.role}</p>
          {/* Native disclosure: no JavaScript, keyboard accessible, and the bio
              stays in the HTML for search engines. */}
          <details class="member__bio">
            <summary>
              <span class="member__more">Biography</span>
            </summary>
            <div class="prose">
              <Content />
            </div>
          </details>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .team { list-style: none; margin: 0; padding: 0; }

  .member {
    display: grid;
    gap: 1.25rem 2.25rem;
    grid-template-columns: minmax(0, 1fr);
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-top: 1px solid var(--line);
  }
  .member:last-child { border-bottom: 1px solid var(--line); }

  @media (min-width: 40rem) {
    .member { grid-template-columns: 13rem minmax(0, 1fr); }
  }

  .member__photo {
    width: 100%;
    max-width: 13rem;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: top center;
    border-radius: var(--radius);
    background: var(--paper-alt);
    filter: grayscale(20%);
  }

  .member__name { font-size: var(--step-2); }
  .member__role {
    margin-top: 0.25rem;
    font-size: var(--step-0);
    color: var(--accent);
    font-weight: 550;
  }

  .member__bio { margin-top: 1rem; }

  .member__bio summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--brand);
    list-style: none;
  }
  .member__bio summary::-webkit-details-marker { display: none; }
  .member__bio summary::after {
    content: '';
    width: 0.45em;
    height: 0.45em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.15em) rotate(45deg);
    transition: transform 160ms ease;
  }
  .member__bio[open] summary::after { transform: translateY(0.05em) rotate(-135deg); }
  .member__bio summary:hover { color: var(--brand-strong); }

  .member__bio .prose {
    margin-top: 1rem;
    color: var(--ink-soft);
  }
</style>
