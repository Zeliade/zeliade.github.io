---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<div class="page-header">
  <div class="shell">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="page-header__lede">{lede}</p>}
  </div>
</div>

<style>
  .page-header {
    padding-block: clamp(2.75rem, 7vw, 5rem) clamp(1.75rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--line-soft);
    background: linear-gradient(to bottom, var(--paper-alt), var(--paper));
  }
  h1 { margin-top: 0.5rem; max-width: 34ch; }
  .page-header__lede {
    margin-top: 1.15rem;
    max-width: 62ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-soft);
  }
</style>
