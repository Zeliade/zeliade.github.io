---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from './PageHeader.astro';
import Section from './Section.astro';

interface Props {
  /** Filename (without .md) in src/content/pages/. */
  slug: string;
}
const { slug } = Astro.props;

const entry = await getEntry('pages', slug);
if (!entry) throw new Error(`Missing src/content/pages/${slug}.md`);
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <PageHeader eyebrow={entry.data.eyebrow} title={entry.data.title} lede={entry.data.lede} />
  <Section narrow>
    <div class="prose">
      <Content />
    </div>
  </Section>
  <slot />
</Base>
