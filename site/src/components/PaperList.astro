---
import { getCollection, render } from 'astro:content';

interface Props {
  /** 'whitepapers' links to the local PDF; 'papers' links out to the journal. */
  kind: 'whitepapers' | 'papers';
}
const { kind } = Astro.props;
const isPaper = kind === 'papers';

const monthYear = (date: Date) =>
  date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });

const entries = (await getCollection(kind)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Normalise both collections into one shape here, so the markup below stays flat.
const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    const data = entry.data;
    return {
      id: entry.id,
      title: data.title,
      href: 'url' in data ? data.url : data.pdf,
      isoDate: data.date.toISOString().slice(0, 7),
      label: monthYear(data.date),
      venue: 'venue' in data ? data.venue : undefined,
      ref: 'ref' in data ? data.ref : undefined,
      Content,
    };
  })
);
---

<ol class="papers">
  {
    items.map((item) => (
      <li class="paper">
        <div class="paper__meta">
          <time datetime={item.isoDate}>{item.label}</time>
          {item.venue && <span class="paper__venue">{item.venue}</span>}
          {item.ref && <span class="paper__ref">{item.ref}</span>}
        </div>

        <div class="paper__body">
          <h3 class="paper__title">
            <a
              href={item.href}
              target={isPaper ? '_blank' : undefined}
              rel={isPaper ? 'noopener' : undefined}
            >
              {item.title}
            </a>
          </h3>

          <div class="paper__abstract prose">
            <item.Content />
          </div>

          <p class="paper__action">
            <a
              class="paper__link"
              href={item.href}
              target={isPaper ? '_blank' : undefined}
              rel={isPaper ? 'noopener' : undefined}
            >
              {isPaper ? 'Read the paper' : 'Download PDF'}
              <span aria-hidden="true">{isPaper ? '↗' : '↓'}</span>
              <span class="visually-hidden"> &mdash; {item.title}</span>
            </a>
          </p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .papers { list-style: none; margin: 0; padding: 0; }

  .paper {
    display: grid;
    gap: 0.5rem 2.5rem;
    padding-block: clamp(1.75rem, 4vw, 2.5rem);
    border-top: 1px solid var(--line);
  }
  .paper:last-child { border-bottom: 1px solid var(--line); }

  @media (min-width: 52rem) {
    .paper { grid-template-columns: 11rem minmax(0, 1fr); }
  }

  .paper__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 52rem) {
    .paper__meta { flex-direction: column; gap: 0.3rem; padding-top: 0.45rem; }
  }

  .paper__meta time { font-weight: 600; color: var(--ink-soft); }
  .paper__venue { font-style: italic; }
  .paper__ref {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.82em;
  }

  .paper__title { font-size: var(--step-2); max-width: 46ch; }
  .paper__title a { color: var(--ink); }
  .paper__title a:hover { color: var(--brand); text-decoration: none; }

  .paper__abstract { margin-top: 0.85rem; color: var(--ink-soft); }

  .paper__action { margin-top: 1.1rem; }
  .paper__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
</style>
