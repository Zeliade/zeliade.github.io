---
interface Props {
  logos: { name: string; src: string }[];
}
const { logos } = Astro.props;
---

<ul class="logo-grid">
  {
    logos.map((logo) => (
      <li>
        <img src={logo.src} alt={logo.name} loading="lazy" decoding="async" />
      </li>
    ))
  }
</ul>

<style>
  .logo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 1px;
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .logo-grid li {
    display: grid;
    /* One explicit track each way. An implicit `auto` track would be sized by
       the logo itself, which makes the image's own percentage sizing cyclic;
       `minmax(0, 1fr)` of a definite-height cell is definite, so the image can
       be clamped against it. */
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    /* A definite height, not aspect-ratio: a grid item's automatic minimum size
       is content-based, so a logo taller than the cell's implied height would
       stretch its own cell and break the row alignment. */
    height: clamp(5rem, 7vw, 6.25rem);
    padding: 0.9rem 1.15rem;
    background: var(--paper);
  }

  .logo-grid img {
    /* Clamped on both axes against the definite track above, so no source
       aspect ratio can overflow the cell. object-fit guards the rest. */
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    /* Legacy logos are mixed-quality PNGs on white; desaturate slightly so the
       wall reads as one set, and restore full colour on hover. */
    filter: grayscale(100%);
    opacity: 0.72;
    transition: filter 180ms ease, opacity 180ms ease;
  }
  .logo-grid li:hover img { filter: none; opacity: 1; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .logo-grid img {
      /* The source PNGs assume a white background. */
      background: #fff;
      padding: 0.35rem;
      border-radius: 3px;
    }
  }
</style>
